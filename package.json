{
  "name": "@halo-dev/cli",
  "version": "1.4.0",
  "description": "CLI for managing Halo (https://www.halo.run) instances.",
  "keywords": [
    "blog",
    "cli",
    "cms",
    "halo",
    "halo-cli",
    "headless-cms",
    "management"
  ],
  "homepage": "https://github.com/halo-dev/cli#readme",
  "bugs": {
    "url": "https://github.com/halo-dev/cli/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Halo",
    "url": "https://github.com/halo-dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halo-dev/cli.git"
  },
  "bin": {
    "halo": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config",
    "build": "vp pack",
    "dev": "vpx src/cli.ts",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "release": "vp exec release-it",
    "release:dry": "vp exec release-it --dry-run",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.27.0",
    "@inquirer/prompts": "^8.7.5",
    "@napi-rs/keyring": "^2.1.2",
    "axios": "^1.21.0",
    "cac": "^7.1.0",
    "cli-table3": "^0.6.5",
    "dayjs": "^1.11.23",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^10.0.0",
    "mime-types": "^3.0.2",
    "ora": "^10.0.0",
    "pretty-bytes": "^7.2.0",
    "semver": "^7.8.6",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
